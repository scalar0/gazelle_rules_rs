load("@gazelle//:def.bzl", "gazelle", "gazelle_binary")
load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load(":rustc.bzl", "rustc_runfiles", "tool_paths")

exports_files([
    "cargo.MODULE.bazel",
    "config.bzl",
    "configuration.schema.json",
])

exports_files(
    ["metadata.schema.json"],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "linux_amd64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

config_setting(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
)

config_setting(
    name = "darwin_amd64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:osx",
    ],
)

config_setting(
    name = "darwin_arm64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:osx",
    ],
)

filegroup(
    name = "cargo",
    srcs = select({
        ":darwin_amd64": ["@gazelle_cargo_darwin_amd64//:cargo/bin/cargo"],
        ":darwin_arm64": ["@gazelle_cargo_darwin_arm64//:cargo/bin/cargo"],
        ":linux_amd64": ["@gazelle_cargo_linux_amd64//:cargo/bin/cargo"],
        ":linux_arm64": ["@gazelle_cargo_linux_arm64//:cargo/bin/cargo"],
    }),
)

rustc_runfiles(name = "rustc")

filegroup(
    name = "rustc_sysroot",
    srcs = [":rustc"],
    output_group = "sysroot",
)

tool_paths(
    name = "tool_paths",
    cargo = ":cargo",
    rustc = ":rustc",
)

go_library(
    name = "rules_rs",
    srcs = [
        "configuration.go",
        "contexts.go",
        "gazelle.go",
        "generate.go",
        "handlers.go",
        "lints.go",
        "metadata.go",
        "options.go",
        "platforms.go",
        "vendor_config.go",
        ":tool_paths",
    ],
    data = [
        ":cargo",
        ":rustc",
    ],
    embedsrcs = [
        "metadata.schema.json",
        "configuration.schema.json",
    ],
    importpath = "github.com/scalar0/gazelle_rules_rs",
    visibility = ["//visibility:public"],
    deps = [
        "@com_github_bazelbuild_buildtools//build",
        "@com_github_pelletier_go_toml_v2//:go-toml",
        "@com_github_santhosh_tekuri_jsonschema_v6//:jsonschema",
        "@gazelle//v2/config",
        "@gazelle//v2/errors",
        "@gazelle//v2/label",
        "@gazelle//v2/language",
        "@gazelle//v2/rule",
        "@rules_go//go/runfiles",
    ],
)

go_binary(
    name = "vendor-config",
    srcs = ["vendor-config/main.go"],
    data = [
        ":cargo",
        ":rustc",
    ],
    deps = [":rules_rs"],
)

gazelle_binary(
    name = "gazelle_binary",
    languages = [":rules_rs"],
    version = 2,
)

gazelle(
    name = "gazelle",
    gazelle = ":gazelle_binary",
)

go_test(
    name = "rules_rs_test",
    srcs = [
        "tests/contexts.go",
        "tests/generate.go",
        "tests/handlers.go",
        "tests/options.go",
        "tests/platforms.go",
        "tests/reconcile.go",
        "tests/vendor_config.go",
    ],
    embed = [":rules_rs"],
    deps = [
        "@gazelle//v2/merger",
        "@gazelle//v2/rule",
    ],
)

# Cargo uses the registered Rust compiler to read target configuration.
go_test(
    name = "rules_rs_integration_test",
    srcs = [
        "tests/cargo_vendor.go",
        "tests/integration.go",
    ],
    args = [
        "-gazelle=$(rlocationpath :gazelle_binary)",
        "-fixture=$(rlocationpath testdata/workspace/Cargo.toml)",
        "-cargo=$(rlocationpath :cargo)",
        "-rustc=$(rlocationpath :rustc)",
        "-sysroot=$(rlocationpath :rustc_sysroot)",
        "-vendor-config=$(rlocationpath :vendor-config)",
    ],
    data = [
        ":cargo",
        ":gazelle_binary",
        ":rustc",
        ":rustc_sysroot",
        ":vendor-config",
    ] + glob(["testdata/workspace/**"]),
    deps = ["@rules_go//go/runfiles"],
)

filegroup(
    name = "rust_fixture_sources",
    srcs = glob(["testdata/**/*.rs"]),
    tags = ["lint-with-rust"],
)
