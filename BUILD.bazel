load("@gazelle//:def.bzl", "gazelle", "gazelle_binary")
load(":rustc.bzl", "rustc_runfiles")

exports_files([
    "cargo.MODULE.bazel",
    "fixtures.MODULE.bazel",
    "config.bzl",
    "testdata/patches/manifest-workspace.patch",
    ".shellcheckrc",
])

# gazelle:prefix github.com/scalar0/gazelle_rules_rs
# gazelle:exclude tests
# gazelle:exclude testdata

alias(
    name = "metadata.schema.json",
    actual = "//src:metadata.schema.json",
    visibility = ["//visibility:public"],
)

alias(
    name = "configuration.schema.json",
    actual = "//src:configuration.schema.json",
    visibility = ["//visibility:public"],
)

config_setting(
    name = "linux_amd64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

config_setting(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
)

config_setting(
    name = "darwin_amd64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:osx",
    ],
)

config_setting(
    name = "darwin_arm64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:osx",
    ],
)

filegroup(
    name = "cargo",
    srcs = select({
        ":darwin_amd64": ["@gazelle_cargo_darwin_amd64//:cargo/bin/cargo"],
        ":darwin_arm64": ["@gazelle_cargo_darwin_arm64//:cargo/bin/cargo"],
        ":linux_amd64": ["@gazelle_cargo_linux_amd64//:cargo/bin/cargo"],
        ":linux_arm64": ["@gazelle_cargo_linux_arm64//:cargo/bin/cargo"],
    }),
    visibility = ["//visibility:public"],
)

rustc_runfiles(
    name = "rustc",
    visibility = ["//visibility:public"],
)

filegroup(
    name = "rustc_sysroot",
    srcs = [":rustc"],
    output_group = "sysroot",
    visibility = ["//src/integration:__pkg__"],
)

alias(
    name = "rules_rs",
    actual = "//src",
    visibility = ["//visibility:public"],
)

alias(
    name = "vendor-config",
    actual = "//src/cmd/vendor-config",
    visibility = ["//visibility:public"],
)

gazelle_binary(
    name = "gazelle_binary",
    languages = [":rules_rs"],
    version = 2,
)

gazelle(
    name = "gazelle",
    gazelle = ":gazelle_binary",
)

gazelle_binary(
    name = "gazelle_go_binary",
    languages = ["@gazelle//language/go"],
    version = 2,
)

gazelle(
    name = "gazelle_go",
    gazelle = ":gazelle_go_binary",
    mode = "diff",
)

gazelle(
    name = "gazelle_go_update",
    gazelle = ":gazelle_go_binary",
)

alias(
    name = "rules_rs_test",
    actual = "//src:src_test",
)

alias(
    name = "rules_rs_integration_test",
    actual = "//src/integration:integration_test",
)

filegroup(
    name = "rust_fixture_sources",
    srcs = glob(["testdata/**/*.rs"]),
    tags = ["lint-with-rust"],
)

filegroup(
    name = "fixture_sources",
    srcs = glob(
        ["testdata/**"],
        exclude = ["testdata/**/target/**"],
    ),
    visibility = ["//visibility:public"],
)

alias(
    name = "consumer-test",
    actual = "//src/cmd/consumer-test",
    visibility = ["//visibility:public"],
)

filegroup(
    name = "consumer_templates",
    srcs = [
        "tests/consumer/.bazelversion",
        "tests/consumer/BUILD.bazel.in",
        "tests/consumer/MODULE.bazel.in",
        "tests/consumer/REPO.bazel.in",
        "tests/consumer/metadata/BUILD.bazel.in",
        "tests/consumer/owned.bzl",
        "tests/consumer/upstream.bzl",
    ],
    visibility = ["//visibility:public"],
)

gazelle_binary(
    name = "integration_runner",
    languages = ["//src/integration/metadata"],
    version = 2,
    visibility = ["//src/integration:__pkg__"],
)

exports_files(
    [
        "testdata/workspace/Cargo.toml",
        "testdata/workspace/backend.json",
        "tests/consumer/MODULE.bazel.in",
    ],
    visibility = ["//src:__subpackages__"],
)
