load("@rules_rust//rust:defs.bzl", "rust_doc", "rust_doc_test")
load("@rust_rules//rs:rust_library.bzl", "rust_library")
load("@rust_rules//rs:rust_test.bzl", "rust_test")
load("@third_party_crates//:defs.bzl", "aliases", "all_crate_deps", "crate_name", "edition", "lint_config")

#CODEGEN:gazelle_rules_rs
rust_library(
    name = "lib",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    aliases = aliases(),
    compile_data = [],
    crate_features = [],
    crate_name = crate_name(),
    crate_root = "src/lib.rs",
    edition = edition(),
    lint_config = lint_config(),
    rustc_env = {
        "CARGO_PKG_DESCRIPTION": "",
        "CARGO_PKG_NAME": "cargo_manifest_path_env",
    },
    version = "0.1.0",
    deps = all_crate_deps(normal = True),
)

#CODEGEN:gazelle_rules_rs
rust_test(
    name = "tests/unit/lib",
    aliases = aliases(),
    compile_data = [],
    crate = ":lib",
    crate_features = [],
    edition = edition(),
    lint_config = lint_config(),
    rustc_env = {
        "CARGO_PKG_DESCRIPTION": "",
        "CARGO_PKG_NAME": "cargo_manifest_path_env",
    },
    version = "0.1.0",
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

#CODEGEN:gazelle_rules_rs
rust_test(
    name = "tests/bench/lib",
    aliases = aliases(),
    args = ["--bench"],
    compile_data = [],
    crate = ":lib",
    crate_features = [],
    edition = edition(),
    lint_config = lint_config(),
    rustc_env = {
        "CARGO_PKG_DESCRIPTION": "",
        "CARGO_PKG_NAME": "cargo_manifest_path_env",
    },
    tags = ["manual"],
    version = "0.1.0",
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

#CODEGEN:gazelle_rules_rs
rust_doc_test(
    name = "tests/doc",
    crate = ":lib",
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ),
)

#CODEGEN:gazelle_rules_rs
rust_doc(
    name = "docs/lib",
    crate = ":lib",
    crate_features = [],
)

#CODEGEN:gazelle_rules_rs
alias(
    name = "cargo_manifest_path_env",
    actual = ":lib",
)
