# Keep Go package metadata when different packages use the same target name.
# Upstream: https://github.com/bazel-contrib/rules_lint/commit/46361f882415c2206bebe575f59c5aefa3257529
# The upstream action copies each file by basename and replaces earlier files.
# Keep this patch until upstream preserves every package metadata file.
# The lint fixture imports two libraries whose Bazel targets both use the name lib.

--- a/lint/golangci_lint.bzl
+++ b/lint/golangci_lint.bzl
@@ -80,7 +80,7 @@
     ctx.actions.run_shell(
         inputs = stage_inputs,
         outputs = [json_dir],
-        command = 'dir="$1"; shift; mkdir -p "$dir"; for f in "$@"; do dest="$dir/$(basename "$f")"; cp -f "$f" "$dest"; chmod u+w "$dest"; done',
+        command = 'dir="$1"; shift; mkdir -p "$dir"; i=0; for f in "$@"; do dest="$dir/$i.pkg.json"; i=$((i+1)); cp -f "$f" "$dest"; chmod u+w "$dest"; done',
         arguments = [stage_args],
         mnemonic = mnemonic + "Stage",
         progress_message = "Staging Go package metadata for %{label}",
