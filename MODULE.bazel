module(
    name = "gazelle_rules_rs",
    version = "0.0.0",
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_lib", version = "3.8.0")
bazel_dep(name = "rules_go", version = "0.65.0")
bazel_dep(name = "gazelle", version = "2.0.0-beta.2")
bazel_dep(name = "rules_rs", version = "0.2.4")
bazel_dep(name = "llvm", version = "0.8.27")

rules_rust = use_extension("@rules_rs//rs:rules_rust.bzl", "rules_rust")
use_repo(rules_rust, "rules_rust")

go_sdk = use_extension(
    "@rules_go//go:extensions.bzl",
    "go_sdk",
    dev_dependency = True,
)
go_sdk.from_file(
    name = "go_sdk",
    go_mod = "//:go.mod",
)
use_repo(go_sdk, "go_sdk")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(
    go_deps,
    "com_github_bazelbuild_buildtools",
    "com_github_pelletier_go_toml_v2",
    "com_github_santhosh_tekuri_jsonschema_v6",
)

include("//:cargo.MODULE.bazel")
include("//:fixtures.MODULE.bazel")

toolchains = use_extension(
    "@rules_rs//rs/toolchains:module_extension.bzl",
    "toolchains",
    dev_dependency = True,
)
toolchains.toolchain(
    edition = "2024",
    version = "1.99.1",
)
use_repo(toolchains, "default_rust_toolchains")

register_toolchains(
    "@default_rust_toolchains//rustc:all",
    "@llvm//toolchain:all",
    dev_dependency = True,
)

# Development checks use the same tools as the source repository.
bazel_dep(
    name = "rules_lint",
    version = "2.9.1",
    dev_dependency = True,
)
bazel_dep(
    name = "buildifier_prebuilt",
    version = "10.1.0",
    dev_dependency = True,
)
bazel_dep(
    name = "rules_shell",
    version = "0.8.0",
    dev_dependency = True,
)

single_version_override(
    module_name = "buildifier_prebuilt",
    patch_strip = 1,
    patches = ["//tools/lint:buildifier_prebuilt_runfiles.patch"],
)

# Formatter dependencies belong to the development tools.
bazel_dep(
    name = "rules_nodejs",
    version = "6.7.7",
    dev_dependency = True,
)
bazel_dep(
    name = "aspect_rules_js",
    version = "3.6.1",
    dev_dependency = True,
)

node = use_extension(
    "@rules_nodejs//nodejs:extensions.bzl",
    "node",
    dev_dependency = True,
)
node.toolchain(node_version = "26.13.0")
use_repo(node, "nodejs_toolchains")

register_toolchains(
    "@nodejs_toolchains//:all",
    dev_dependency = True,
)

pnpm = use_extension(
    "@aspect_rules_js//npm:extensions.bzl",
    "pnpm",
    dev_dependency = True,
)
pnpm.pnpm(pnpm_version_from = "//tools:package.json")
use_repo(pnpm, "pnpm")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm", dev_dependency = True)
npm.npm_translate_lock(
    name = "gazelle_rules_rs_npm",
    data = ["//tools:pnpm-workspace.yaml"],
    pnpm_lock = "//tools:pnpm-lock.yaml",
    update_pnpm_lock = False,
)
use_repo(npm, npm = "gazelle_rules_rs_npm")

# The pinned source provides Go lint support before the next stable release.
archive_override(
    module_name = "rules_lint",
    patch_strip = 1,
    patches = ["//tools/lint:golangci_metadata_paths.patch"],
    sha256 = "f032645c2dca8a623a1a906e240afa194cb5fc442759771769aa9ff1c06c5f2d",
    strip_prefix = "rules_lint-46361f882415c2206bebe575f59c5aefa3257529",
    urls = ["https://github.com/bazel-contrib/rules_lint/archive/46361f882415c2206bebe575f59c5aefa3257529.tar.gz"],
)

bazel_dep(
    name = "rules_multitool",
    version = "0.11.0",
    dev_dependency = True,
)

multitool = use_extension(
    "@rules_multitool//multitool:extension.bzl",
    "multitool",
    dev_dependency = True,
)
multitool.hub(lockfile = "//tools/lint:multitool.lock.json")
