"""Configure Bazel and shell lint checks for the standalone extension."""

load("@aspect//lint.axl", _lint = "lint")
load("./maintenance.axl", "BAZEL_CHECK_FLAGS")

_ASPECTS = [
    "//tools/lint:linters.bzl%buildifier",
    "//tools/lint:linters.bzl%shellcheck",
]

lint_all = _lint.alias(
    defaults = {
        "aspects": _ASPECTS,
        "base_ref": "HEAD",
        "strategy": "hard",
    },
    summary = "Check Bazel and shell policies.",
)

def configure(ctx):
    """Set defaults for the built-in lint task.

    Args:
        ctx: The Aspect configuration context.
    """
    ctx.tasks["lint"].args.aspects = _ASPECTS
    ctx.tasks["lint"].args.strategy = "hard"
    ctx.tasks["lint"].args.base_ref = "HEAD"
    for name in ["lint", "lint-all"]:
        ctx.tasks[name].args.rules_lint_fix_flag = "@aspect_rules_lint//lint:fix"
        ctx.tasks[name].args.bazel_flags = BAZEL_CHECK_FLAGS + ["--remote_download_regex=.*AspectRulesLint.*"]
