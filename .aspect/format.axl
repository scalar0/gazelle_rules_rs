"""Configure source format tasks from tools."""

load("@aspect//format.axl", _format = "format")

_FORMATTER = "//tools:format"

format_sources = _format.alias(
    defaults = {
        "formatter_target": _FORMATTER,
        "scope": "changed",
        "severity": "info",
        "upload_format_diff": False,
    },
    summary = "Format source files.",
)
format_check = _format.alias(
    defaults = {
        "formatter_target": _FORMATTER + ".check",
        "scope": "all",
        "severity": "fail",
        "upload_format_diff": False,
    },
    summary = "Check source formats without changing files.",
)

def configure(ctx):
    """Set the formatter target for the built-in format task.

    Args:
        ctx: The Aspect configuration context.
    """
    ctx.tasks["format"].args.formatter_target = _FORMATTER
    ctx.tasks["format"].args.upload_format_diff = False
