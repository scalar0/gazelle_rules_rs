module(name = "gazelle_rules_rs_consumer")

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(
    name = "rules_rs",
    version = "0.2.4",
    repo_name = "rust_rules",
)
bazel_dep(name = "llvm", version = "0.8.27")

PLATFORM_TRIPLES = [
    "aarch64-apple-darwin",
    "aarch64-unknown-linux-gnu",
    "x86_64-apple-darwin",
    "x86_64-unknown-linux-gnu",
]

crate = use_extension("@rust_rules//rs:extensions.bzl", "crate")
crate.from_cargo(
    name = "third_party_crates",
    cargo_lock = "//:Cargo.lock",
    cargo_toml = "//:Cargo.toml",
    generate_lint_config = True,
    platform_triples = PLATFORM_TRIPLES,
)
use_repo(crate, "third_party_crates")

toolchains = use_extension("@rust_rules//rs/toolchains:module_extension.bzl", "toolchains")
toolchains.toolchain(
    edition = "2024",
    version = "1.99.1",
)
use_repo(toolchains, "default_rust_toolchains")

register_toolchains("@default_rust_toolchains//rustc:all", "@llvm//toolchain:all")

bazel_dep(name = "gazelle_rules_rs", version = "0.0.0")
local_path_override(
    module_name = "gazelle_rules_rs",
    path = "../..",
)

bazel_dep(name = "gazelle", version = "2.0.0-beta.2")

backend_config = use_repo_rule("@gazelle_rules_rs//:config.bzl", "backend_config")

backend_config(
    name = "gazelle_backend",
    crates_repository = "third_party_crates",
    platform_triples = PLATFORM_TRIPLES,
    rules_repository = "rust_rules",
)

rules_rust = use_extension("@rust_rules//rs:rules_rust.bzl", "rules_rust")
use_repo(rules_rust, "rules_rust")

bazel_dep(name = "rules_go", version = "0.65.0")
