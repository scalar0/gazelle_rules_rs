load("@gazelle//:def.bzl", "gazelle", "gazelle_binary")

gazelle_binary(
    name = "runner",
    languages = ["//metadata:language"],
    version = 2,
)

gazelle(
    name = "gazelle",
    args = ["-rules_rs_config=$(location @gazelle_backend//:config.json)"],
    data = ["@gazelle_backend//:config.json"],
    gazelle = ":runner",
)
